# Copiar a .env para arrancar Compose.
API_ENV=dev
FRONTEND_URL=http://127.0.0.1:5190
BOOKING_DB_PASSWORD=replace-with-local-database-password

# Compose fija API_PORT=8080, TZ=America/Santiago y construye DATABASE_URL
# hacia postgres, compartida con Goose. Fuera de Compose exportar además:
# API_PORT=8080
# TZ=America/Santiago
# DATABASE_URL=replace-with-postgresql-url
# API_DOCS_DIR=/docs
# BOOKING_API_URL=http://backend:8080

# Opcional. Usar solo con el mock de Notificaciones y un correo de prueba.
NOTIFICACIONES_URL=
NOTIFICACIONES_DEMO_DESTINATARIO=

# Vacíos para la demo en dev. En test y prod usar los valores de Identidad.
# AUTH_JWKS_URL=replace-with-https-jwks-url
# AUTH_COOKIE_NAME=replace-with-identity-cookie-name
# BOOKING_JWT_ISSUER=replace-with-issuer
# BOOKING_JWT_AUDIENCE=replace-with-audience
AUTH_JWKS_URL=
AUTH_COOKIE_NAME=
BOOKING_JWT_ISSUER=
BOOKING_JWT_AUDIENCE=

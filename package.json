{
  "name": "bookingms",
  "private": true,
  "scripts": {
    "codegen:externos": "go -C apps/api generate ./internal/store/notificaciones",
    "codegen": "go -C apps/api run ./cmd/openapi ../../contracts/openapi.yaml && pnpm --dir apps/web run contracts",
    "lint": "oxlint --deny-warnings apps/web/src apps/web/tests",
    "format": "prettier --write --ignore-unknown \"apps/web/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check --ignore-unknown \"apps/web/**/*.{ts,tsx,css,json}\"",
    "typecheck": "pnpm --dir apps/web exec tsc --noEmit",
    "test": "pnpm --dir apps/web test",
    "test:api": "go -C apps/api test ./...",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm --dir apps/web build"
  },
  "devDependencies": {
    "lefthook": "2.1.10",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "engines": {
    "node": "22.22.0"
  },
  "packageManager": "pnpm@10.13.1"
}

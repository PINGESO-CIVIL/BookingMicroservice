FROM golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc AS build
RUN CGO_ENABLED=0 GOBIN=/out go install -trimpath \
    -tags 'no_clickhouse no_mssql no_mysql no_sqlite3 no_libsql no_vertica no_ydb' \
    -ldflags="-s -w" github.com/pressly/goose/v3/cmd/goose@v3.24.1

FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
COPY --from=build /out/goose /goose
COPY apps/api/db/migrations/ /migrations/
USER 65532:65532
ENTRYPOINT ["/goose", "-dir", "/migrations", "-table", "public.goose_db_version", "up"]
